{
  "name": "videogamelibraryappweb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8789",
    "build": "tsc -b && tsc -p functions && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name videogamelibraryappweb --branch main",
    "primer-despliegue": "node scripts/primer-despliegue.mjs",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.91.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
